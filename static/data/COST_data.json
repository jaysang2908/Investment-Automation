iwan, Japan, and Australia. The company was formerly known as Costco Companies, Inc. and changed its name to Costco Wholesale Corporation in August 1999. Costco Wholesale Corporation was founded in 1976 and is based in Issaquah, Washington.", "ceo": "Ron Vachris", "sector": "Consumer Defensive", "country": "US", "fullTimeEmployees": "333000", "phone": "425 313 8100", "address": "999 Lake Drive", "city": "Issaquah", "state": "WA", "zip": "98027", "image": "https://images.financialmodelingprep.com/symbol/COST.png", "ipoDate": "1986-07-09", "defaultImage": false, "isEtf": false, "isActivelyTrading": true, "isAdr": false, "isFund": false}, "years": ["2021", "2022", "2023", "2024", "2025"], "is_data": [{"date": "2021-08-29", "symbol": "COST", "reportedCurrency": "USD", "cik": "0000909832", "filingDate": "2021-10-06", "acceptedDate": "2021-10-05 20:49:17", "fiscalYear": "2021", "period": "FY", "revenue": 195929000000, "costOfRevenue": 170684000000, "grossProfit": 25245000000, "researchAndDevelopmentExpenses": 0, "generalAndAdministrativeExpenses": 0, "sellingAndMarketingExpenses": 0, "sellingGeneralAndAdministrativeExpenses": 18461000000, "otherExpenses": 76000000, "operatingExpenses": 18537000000, "costAndExpenses": 189221000000, "netInterestIncome": -130000000, "interestIncome": 41000000, "interestExpense": 171000000, "depreciationAndAmortization": 1781000000, "ebitda": 8632000000, "ebit": 6851000000, "nonOperatingIncomeExcludingInterest": -143000000, "operatingIncome": 6708000000, "totalOtherIncomeExpensesNet": -28000000, "incomeBeforeTax": 6680000000, "incomeTaxExpense": 1601000000, "netIncomeFromContinuingOperations": 5079000000, "netIncomeFromDiscontinuedOperations": 0, "otherAdjustmentsToNetIncome": 0, "netIncome": 5007000000, "netIncomeDeductions": 0, "bottomLineNetIncome": 5007000000, "eps": 11.3, "epsDiluted": 11.27, "weightedAverageShsOut": 443089000, "weightedAverageShsOutDil": 444346000}, {"date": "2022-08-28", "symbol": "COST", "reportedCurrency": "USD", "ci